# Environment variable template for advanced-rag.
#
# Usage:
#   1. Copy this file to .env  (PowerShell: Copy-Item .env.example .env)
#   2. Fill in real values in .env only. .env is git-ignored.
#   3. Never put real credentials in this file; it is committed.
#
# Note: rag_app reads values from the process environment. It does not load
# .env automatically yet; set variables in PowerShell, e.g.
#   $env:RAG_CHUNK_SIZE = "800"
#
# The LLM provider, embedding model, vector store and tracing (LangSmith) have
# not been chosen. Their variables will be added in the milestone that
# introduces them.

# --- Data folders (relative paths are resolved from the project root) ---
# Folder with the original source documents. Default: data/raw
RAG_RAW_DATA_DIR=data/raw
# Folder where generated chunks are written. Default: data/processed
RAG_PROCESSED_DATA_DIR=data/processed

# --- Chunking (all optional; defaults shown) ---
# Maximum characters per chunk. Must be greater than 0.
RAG_CHUNK_SIZE=1000
# Characters shared between neighbouring chunks. Must be smaller than RAG_CHUNK_SIZE.
RAG_CHUNK_OVERLAP=150
# Chunking strategy: "fixed" (baseline, cuts every N characters) or
# "recursive" (prefers paragraph, then line, then word boundaries).
RAG_CHUNK_STRATEGY=recursive

# --- Embeddings (run locally; no API key needed) ---
# Hugging Face model name. Downloaded once to the Hugging Face cache in your
# user folder. Default: BAAI/bge-small-en-v1.5
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Texts embedded per batch. Default: 32
RAG_EMBEDDING_BATCH_SIZE=32
# Put in front of queries only. Set to an empty value to switch it off.
RAG_QUERY_INSTRUCTION=Represent this sentence for searching relevant passages:
# Optional Hugging Face settings (read by the huggingface_hub library):
# HF_HUB_OFFLINE=1            use only models already downloaded
# HF_HUB_DISABLE_TELEMETRY=1  do not send library usage statistics

# --- Evaluation ---
# Evaluation questions file. Default: evals/datasets/questions.jsonl
RAG_EVAL_DATASET_PATH=evals/datasets/questions.jsonl
